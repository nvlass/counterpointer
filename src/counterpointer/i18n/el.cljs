(ns counterpointer.i18n.el
  (:require [clojure.string :as str]
            [counterpointer.theory :as t]))

;; Phrases avoid noun cases where they can: "κατά" + accusative, or a colon, keeps interval names
;; in the nominative form that the formatting functions produce.

;; ---------------------------------------------------------------- formatting

(defn- note [loc n] (t/note-name n (:names loc)))
(defn- pcn [loc n] (t/pc-name n (:names loc)))
(defn- fin [loc f] (t/final-name f (:names loc)))

(def ^:private modes
  {:dorian "Δώριος" :phrygian "Φρύγιος" :lydian "Λύδιος" :mixolydian "Μιξολύδιος"
   :aeolian "Αιολικός (ελάσσονα)" :ionian "Ιωνικός (μείζονα)"})

(defn- key-name [loc {:keys [mode final]}] (str (fin loc final) " " (modes mode)))

(def ^:private q-label {:P "Κ" :M "Μ" :m "μ" :A "Α" :d "Ε" :AA "ΑΑ" :dd "ΕΕ"})

(defn- iv-name [{:keys [num q]}] (str (q-label q) num))

(def ^:private iv-words {1 "ταυτοφωνία" 8 "οκτάβα" 15 "δύο οκτάβες"})

(def ^:private q-words
  {:P "καθαρή" :M "μεγάλη" :m "μικρή" :A "αυξημένη" :d "ελαττωμένη"
   :AA "δις αυξημένη" :dd "δις ελαττωμένη"})

(defn- iv-long [{:keys [num q] :as iv}]
  (cond
    (t/tritone? iv) (str "τρίτονο (" (q-words q) " " num "η)")
    (= num 15) (str (when-not (= q :P) (str (q-words q) " ")) "δύο οκτάβες")
    :else (str (q-words q) " " (iv-words num (str num "η")))))

(defn- perfects [v] (cond (zero? (:g v)) "ταυτοφωνίες" (zero? (:g7 v)) "οκτάβες" :else "5ες"))

(defn- pair [v w] (str "(" (:num v) " → " (:num w) ")"))

(defn- imperfects [g7] (if (= 2 g7) "3ες" "6ες"))

(defn- vs-imperfect [p i]
  (str p (if (= p 1) " τέλεια" " τέλειες") " έναντι " i (if (= i 1) " ατελούς συμφωνίας" " ατελών συμφωνιών")))

(def ^:private motions
  {:contrary "αντίθετη" :oblique "πλάγια" :similar "ευθεία" :parallel "παράλληλη" :static "στατική"})

;; ---------------------------------------------------------------- dictionary

(def dict
  {:fmt
   {:note note
    :pc pcn
    :final fin
    :key key-name
    :mode (fn [_ id] (modes id))
    :on-final (fn [loc f] (str "σε " (fin loc f)))
    :signature (fn [_ s] (cond (zero? s) "χωρίς αλλοιώσεις" (pos? s) (str s " ♯") :else (str (- s) " ♭")))
    :iv-name (fn [_ v] (iv-name v))
    :iv-long (fn [_ v] (iv-long v))
    :iv (fn [_ v] (str (iv-name v) ": " (iv-long v)))
    :motion (fn [_ k] (motions k))
    :motion-abbr (fn [_ k] ({:contrary "α" :oblique "πλ" :similar "ε" :parallel "π" :static "–"} k))}

   :bars
   {:one (fn [_ n] (str "μέτρο " n))
    :range (fn [_ x y] (str "μέτρα " x "–" y))
    :list (fn [_ cs] (str "μέτρα " (str/join ", " cs)))
    :beat (fn [_ n down?] (str "μέτρο " n (if down? ", ισχυρός χρόνος" ", ασθενής χρόνος")))}

   :parse
   {:too-many (fn [_ n] (str "Το πολύ " n " νότες"))
    :bad-token (fn [_ tok] (str "Δεν αναγνωρίζεται το «" tok "»"))}

